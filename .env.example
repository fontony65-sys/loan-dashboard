# Copy to .env (or set these in Render → Environment). Never commit real values.
# Turso (hosted libSQL). Leave both empty to use the local file db/loans.db.
TURSO_DATABASE_URL=libsql://your-db-name-your-account.turso.io
TURSO_AUTH_TOKEN=
# Login. ADMIN_PASSWORD is REQUIRED when NODE_ENV=production.
ADMIN_USER=admin
ADMIN_PASSWORD=
NODE_ENV=production
# Optional
CURRENCY=XAF
SEED_EXAMPLE_DATA=false
# PORT is set automatically by Render; defaults to 3000 locally.
PORT=3000
